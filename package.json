    "@mlc-ai/web-llm": "^0.2.81",
    "axios": "^1.13.5",
    "framer-motion": "^11.0.0",
    "jspdf": "^2.5.2",
    "lucide-react": "^0.400.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sonner": "^1.5.0",
    "tesseract.js": "^5.1.0",
    "tw-animate-css": "^1.0.0",
    "wouter": "^3.3.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "concurrently": "^9.2.1",
    "tailwindcss": "^4.0.0",
