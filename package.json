{
  "name": "fynix-app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port 8080",
    "build": "vite build && node -e \"require('fs').cpSync('dist', 'backend/public', {recursive: true})\"",
    "preview": "vite preview --port 8080",
    "backend:dev": "cd backend && npm run dev",
    "backend:start": "cd backend && npm start"
  },
